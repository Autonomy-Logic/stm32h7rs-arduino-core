CONFIG_ARDUINO_STM32H7RS_NETBOOT=y
CONFIG_ROM_START_OFFSET=0x400
# CONFIG_RETENTION_BOOT_MODE is not set
CONFIG_MAIN_THREAD_PRIORITY=2
CONFIG_NETWORKING=y
CONFIG_NET_IPV4=y
CONFIG_NET_TCP=y
CONFIG_NET_UDP=y
CONFIG_NET_DHCPV4=y
# CONFIG_NET_IPV6 is not set
# CONFIG_NET_CONFIG_SETTINGS is not set
# CONFIG_NET_CONFIG_AUTO_INIT is not set
# CONFIG_SHELL is not set
CONFIG_NET_TC_THREAD_PREEMPTIVE=y
CONFIG_NET_TC_THREAD_PRIO_CUSTOM=y
CONFIG_NET_TC_TX_THREAD_BASE_PRIO=8
CONFIG_NET_TC_RX_THREAD_BASE_PRIO=8
CONFIG_NET_TCP_WORKER_PRIO=8
CONFIG_NET_SOCKETS_SERVICE_THREAD_PRIO=8
CONFIG_ETH_STM32_HAL=y
CONFIG_ETH_STM32_HAL_RX_THREAD_PREEMPTIVE=y
CONFIG_ETH_STM32_HAL_RX_THREAD_PRIO=8
CONFIG_SYSTEM_WORKQUEUE_PRIORITY=8
