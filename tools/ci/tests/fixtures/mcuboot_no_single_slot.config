CONFIG_BOARD="stm32h7s7_core"
# CONFIG_SINGLE_APPLICATION_SLOT is not set
CONFIG_BOOT_SWAP_USING_MOVE=y
CONFIG_MCUBOOT_SERIAL=y
CONFIG_BOOT_SERIAL_CDC_ACM=y
CONFIG_BOOT_SERIAL_CDC_ACM_VID=0x2fe3
CONFIG_BOOT_SERIAL_CDC_ACM_PID=0x0101
# CONFIG_BOOT_SERIAL_ENTRANCE_GPIO is not set
CONFIG_BOOT_SERIAL_NO_APPLICATION=y
CONFIG_BOOT_SERIAL_BOOT_MODE=y
CONFIG_BOOT_SIGNATURE_TYPE_ECDSA_P256=y
CONFIG_BOOT_SIGNATURE_KEY_FILE="bootloader/keys/stm32h7rs-dev-ecdsa-p256.pem"
