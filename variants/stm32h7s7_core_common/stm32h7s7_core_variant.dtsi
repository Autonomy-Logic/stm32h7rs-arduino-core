/*
 * SPDX-License-Identifier: Apache-2.0
 *
 * Arduino mapping shared by every STM32H7S7 variant: USB CDC ACM as Serial, the loader and sketch partitions inside
 * the program slot, and every GPIO as an Arduino pin numbered port index x 16 + pin (A=0..H=7, M=8, N=9, O=10, P=11).
 */

&zephyr_udc0 {
	board_cdc_acm_uart: board_cdc_acm_uart {
		compatible = "zephyr,cdc-acm-uart";
		status = "okay";
	};
};

&ext_flash {
	partitions {
		loader_partition: loader-partition@0 {
			compatible = "zephyr,mapped-partition";
			label = "loader";
			reg = <0x00000000 0x00080000>;
		};

		user_sketch: partition@80000 {
			compatible = "zephyr,mapped-partition";
			label = "user_sketch";
			reg = <0x00080000 0x00780000>;
		};
	};
};

/ {
	chosen {
		zephyr,code-partition = &loader_partition;
	};

	zephyr,user {
		cdc-acm-serial = <&board_cdc_acm_uart>;
		digital-pin-gpios =
				<&gpioa 0 0>,	/*   0 PA0 */
				<&gpioa 1 0>,	/*   1 PA1 */
				<&gpioa 2 0>,	/*   2 PA2 */
				<&gpioa 3 0>,	/*   3 PA3 */
				<&gpioa 4 0>,	/*   4 PA4 */
				<&gpioa 5 0>,	/*   5 PA5 */
				<&gpioa 6 0>,	/*   6 PA6 */
				<&gpioa 7 0>,	/*   7 PA7 */
				<&gpioa 8 0>,	/*   8 PA8 */
				<&gpioa 9 0>,	/*   9 PA9 */
				<&gpioa 10 0>,	/*  10 PA10 */
				<&gpioa 11 0>,	/*  11 PA11 */
				<&gpioa 12 0>,	/*  12 PA12 */
				<&gpioa 13 0>,	/*  13 PA13 */
				<&gpioa 14 0>,	/*  14 PA14 */
				<&gpioa 15 0>,	/*  15 PA15 */
				<&gpiob 0 0>,	/*  16 PB0 */
				<&gpiob 1 0>,	/*  17 PB1 */
				<&gpiob 2 0>,	/*  18 PB2 */
				<&gpiob 3 0>,	/*  19 PB3 */
