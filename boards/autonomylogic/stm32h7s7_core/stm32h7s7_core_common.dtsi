/*
 * SPDX-License-Identifier: Apache-2.0
 *
 * STM32H7S7 base shared by every device of this core: internal clocks, octal NOR on XSPI2 (XIP), USB OTG FS.
 * Device variants add their own peripherals (Ethernet, buses, PSRAM) and the real flash size.
 */

/dts-v1/;
#include <st/h7rs/stm32h7s7X8.dtsi>
#include <st/h7/stm32h7s7a8ix-pinctrl.dtsi>

/ {
	chosen {
		zephyr,sram = &sram0;
	};

	aliases {
		watchdog0 = &iwdg;
	};

	ext_flash_mem: memory@70000000 {
		compatible = "zephyr,memory-region";
		reg = <0x70000000 DT_SIZE_M(16)>;
		zephyr,memory-region = "EXTMEM";
		zephyr,memory-attr = <DT_MEM_ARM(ATTR_MPU_FLASH)>;
	};
};

&clk_hsi {
	hsi-div = <1>;
	status = "okay";
};

&clk_hsi48 {
	status = "okay";
};

&pll {
	div-m = <8>;
	mul-n = <75>;
	div-p = <1>;
	div-q = <2>;
	div-r = <2>;
	div-s = <2>;
	div-t = <2>;
	clocks = <&clk_hsi>;
	status = "okay";
};

&rcc {
	clocks = <&pll>;
	clock-frequency = <DT_FREQ_M(600)>;
	dcpre = <1>;
	hpre = <2>;
	ppre1 = <2>;
	ppre2 = <2>;
	ppre4 = <2>;
	ppre5 = <2>;
};

&pwr {
	power-supply = "smps-direct";
};

&iwdg {
	status = "okay";
};

&rng {
	status = "okay";
};

&xspim {
	status = "okay";
};

&xspi2 {
	pinctrl-0 = <&xspim_p2_clk_pn6 &xspim_p2_ncs1_pn1
		     &xspim_p2_io0_pn2 &xspim_p2_io1_pn3
		     &xspim_p2_io2_pn4 &xspim_p2_io3_pn5
		     &xspim_p2_io4_pn8 &xspim_p2_io5_pn9
		     &xspim_p2_io6_pn10 &xspim_p2_io7_pn11
		     &xspim_p2_dqs0_pn0>;
	pinctrl-names = "default";
	status = "okay";

	ext_flash_ctrl: xspi-nor-flash@0 {
		compatible = "st,stm32-xspi-nor";
		reg = <0>;
		size = <DT_SIZE_M(128)>; /* 128 Mbits, the minimum this core supports */
		ospi-max-frequency = <DT_FREQ_M(50)>;
		spi-bus-width = <XSPI_OCTO_MODE>;
		data-rate = <XSPI_DTR_TRANSFER>;
		four-byte-opcodes;
		status = "okay";

		#address-cells = <1>;
		#size-cells = <1>;
		ranges = <0x0 0x70000000 DT_SIZE_M(16)>;

		ext_flash: ext-flash@0 {
			compatible = "soc-nv-flash";
			reg = <0x0 DT_SIZE_M(16)>;
			write-block-size = <1>;
			erase-block-size = <DT_SIZE_K(4)>;
			#address-cells = <1>;
			#size-cells = <1>;
			ranges;
		};
	};
};

&iocell {
	status = "okay";

	vddxspi1 {
		hslv-mode = "on";
		compensation-enabled;
	};

	vddxspi2 {
		hslv-mode = "on";
		compensation-enabled;
	};
};

&usbotg_fs {
	pinctrl-0 = <&usb_otg_fs_dm_pm12 &usb_otg_fs_dp_pm11>;
	pinctrl-names = "default";
	status = "okay";
};

zephyr_udc0: &usbotg_fs {};

#include "stm32h7s7_core_flash_layout.dtsi"
